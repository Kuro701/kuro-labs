{
  // Mostly a static site — the Worker only handles /api/sales-count and
  // hands everything else to the ASSETS binding, so normal page serving is
  // unchanged.
  "name": "kuro-labs",
  "compatibility_date": "2026-08-24",
  "main": "site/worker.js",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    // /about/ and /about both resolve to /about/index.html
    "html_handling": "auto-trailing-slash",
    // serve our own themed 404 instead of Cloudflare's default
    "not_found_handling": "404-page",
    // Without this, Cloudflare answers any path that is not a file (like /api/...) with the 404 page and never runs
    // the Worker. Only /api/* goes to the Worker first; every page and image is still served straight from assets.
    "run_worker_first": ["/api/*"]
  },
  // Dragons & Ladders online rooms: one Durable Object per room (class DnlRoom, exported from site/worker.js).
  // new_sqlite_classes is the only storage kind the Workers Free plan allows.
  "durable_objects": {
    "bindings": [{ "name": "DNL_ROOMS", "class_name": "DnlRoom" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DnlRoom"] }
  ],
  // Nightly cleanup of accounts data (03:17 UTC): expired logins and codes, old reports, long-unused accounts.
  "triggers": { "crons": ["17 3 * * *"] },

  // ACCOUNTS (login): the D1 database (created in the Cloudflare dashboard, EU jurisdiction). The tables are created
  // automatically on first use. Logins stay hidden until the Discord/email secrets are added too. See site/accounts/README.md.
  "d1_databases": [
    { "binding": "DB", "database_name": "kuro-labs", "database_id": "4dba3bfb-ac31-40a5-b4df-3fbd3c167218" }
  ]
}
